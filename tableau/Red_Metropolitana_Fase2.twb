              <calculation class='tableau' formula='IF [es_hora_pico] THEN&#13;&#10;    &quot;Hora pico&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Fuera de hora pico&quot;&#13;&#10;END' />
